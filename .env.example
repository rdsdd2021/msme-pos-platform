# ==============================================================================
# MSME POS Platform — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Central PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pos_admin
POSTGRES_PASSWORD=pos_secure_password
POSTGRES_DB=pos_platform

# Authentication & JWT Secrets (Change in Production!)
JWT_SECRET=production_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=production_super_secret_refresh_jwt_key_minimum_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Reverse Proxy Gateway (Production)
HTTP_PORT=80

